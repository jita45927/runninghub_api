      "type": "select",
      "nodeId": "166",
      "fieldName": "value",
      "def": "true,false"
    },
    {
      "label": "输出图片短边尺寸调整为",
      "type": "number",
      "nodeId": "172",
      "fieldName": "size",
      "def": "1024"
    },
    {
      "label": "是否强制填充遮罩为红色",
      "type": "select",
      "nodeId": "174",
      "fieldName": "value",
      "def": "false,true"
    }
  ]
}